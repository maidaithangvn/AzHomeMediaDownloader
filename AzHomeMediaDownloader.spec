# -*- mode: python ; coding: utf-8 -*-
import sys
import os

IS_WINDOWS = sys.platform == 'win32'
IS_MACOS = sys.platform == 'darwin'

# Define platform-specific settings
if IS_WINDOWS:
    icon_file = 'src/ui/assets/icon.ico'
    # Include the checked-in portable FFmpeg binaries in the one-file build.
    # They are extracted to _MEIPASS and resolved by get_bin_dir().
    ffmpeg_binaries = []
    for binary_name in ('ffmpeg.exe', 'ffprobe.exe'):
        binary_path = os.path.join('bin', binary_name)
        if os.path.isfile(binary_path):
            ffmpeg_binaries.append((binary_path, 'bin'))
elif IS_MACOS:
    # Generated by packaging/build_macos.sh
    icon_file = 'src/ui/assets/icon.icns'
else:
    icon_file = 'src/ui/assets/icon.png'

a = Analysis(
    ['src/main.py'],
    pathex=[],
    binaries=ffmpeg_binaries if IS_WINDOWS else [],
    datas=[('src', 'src')],
    hiddenimports=[],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

if IS_WINDOWS:
    # Windows: single-file executable
    exe = EXE(
        pyz,
        a.scripts,
        a.binaries,
        a.datas,
        [],
        name='AzHomeMediaDownloader',
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=True,
        upx_exclude=[],
        runtime_tmpdir=None,
        console=False,
        disable_windowed_traceback=False,
        argv_emulation=False,
        target_arch=None,
        codesign_identity=None,
        entitlements_file=None,
        icon=[icon_file] if os.path.exists(icon_file) else None,
    )
else:
    # Linux/macOS: one-folder build (fast start-up, required for a clean .app bundle)
    exe = EXE(
        pyz,
        a.scripts,
        [],
        exclude_binaries=True,
        name='AzHomeMediaDownloader',
        debug=False,
        bootloader_ignore_signals=False,
        strip=False,
        upx=False,
        console=False,
        disable_windowed_traceback=False,
        argv_emulation=False,
        target_arch=None,
        codesign_identity=None,
        entitlements_file=None,
        icon=[icon_file] if os.path.exists(icon_file) else None,
    )
    coll = COLLECT(
        exe,
        a.binaries,
        a.datas,
        strip=False,
        upx=False,
        name='AzHomeMediaDownloader',
    )

    if IS_MACOS:
        app = BUNDLE(
            coll,
            name='AzHomeMediaDownloader.app',
            icon=icon_file if os.path.exists(icon_file) else None,
            bundle_identifier='top.azhome.mediadownloader',
            info_plist={
                'CFBundleName': 'AzHome Media Downloader',
                'CFBundleDisplayName': 'AzHome Media Downloader',
                'CFBundleShortVersionString': '1.0.0',
                'NSHighResolutionCapable': True,
            },
        )
